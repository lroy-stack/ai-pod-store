# POD AI Store — Development Environment Variables
# =================================================
# Copy this file to .env and replace with your actual API keys and credentials.

# Database (Supabase PostgreSQL)
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# Redis Cache (local development)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=dev-jwt-secret-change-in-production

# Payment Processing (Stripe - test mode)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Fulfillment (Printify)
PRINTIFY_API_TOKEN=placeholder-printify-token
PRINTIFY_SHOP_ID=12345

# AI Services
ANTHROPIC_API_KEY=sk-ant-placeholder
GOOGLE_AI_API_KEY=placeholder-google-ai-key
FAL_AI_API_KEY=placeholder-fal-ai-key

# Email (Resend)
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=noreply@localhost

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Agent Configuration
AGENT_PORT=8000
