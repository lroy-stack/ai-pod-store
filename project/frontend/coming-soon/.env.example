# SKAPARA Coming Soon — Environment Variables
# Copy to .env and fill in your values

# Supabase (public anon key — safe for client-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile (anti-spam)
# Create at: https://dash.cloudflare.com → Turnstile → Add Widget
# Set the widget domain to your coming-soon domain
TURNSTILE_SITE_KEY=your-turnstile-site-key-here
