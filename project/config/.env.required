# POD AI Store — Required Environment Variables
# =============================================

# Database (Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=optional-password-here

# Authentication (Supabase handles OAuth)
JWT_SECRET=your-jwt-secret-here

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Fulfillment (Printify)
PRINTIFY_API_TOKEN=your-printify-api-token
PRINTIFY_SHOP_ID=your-shop-id

# AI Services
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GOOGLE_AI_API_KEY=your-google-gemini-api-key
FAL_AI_API_KEY=your-fal-ai-api-key

# Email (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Frontend URLs
# NEXT_PUBLIC_API_URL not needed — API routes are on same origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Agent Configuration
AGENT_PORT=8000

# Optional: Analytics & Monitoring
SENTRY_DSN=optional-sentry-dsn
POSTHOG_API_KEY=optional-posthog-key
