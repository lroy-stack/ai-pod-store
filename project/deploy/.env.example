# POD AI — Environment Variables
# =================================
# Copy to ../frontend/.env.local and fill in real values.
# docker-compose reads env_file from ../frontend/.env.local

# ---------------------------------------------------------------------------
# Domain (Caddy reverse proxy)
# ---------------------------------------------------------------------------
# DOMAIN=yourdomain.com          # Production: your domain (Caddy auto-HTTPS)
# DOMAIN=localhost                # Local dev: HTTP only on port 80

# ---------------------------------------------------------------------------
# Supabase (cloud-managed)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ---------------------------------------------------------------------------
# Anthropic (Claude Agent SDK)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...your-key

# ---------------------------------------------------------------------------
# Stripe (payments)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ---------------------------------------------------------------------------
# Printify (print-on-demand fulfillment)
# ---------------------------------------------------------------------------
PRINTIFY_API_TOKEN=your-printify-token
PRINTIFY_SHOP_ID=your-shop-id

# ---------------------------------------------------------------------------
# fal.ai (AI image generation)
# ---------------------------------------------------------------------------
FAL_KEY=your-fal-key

# ---------------------------------------------------------------------------
# Google Gemini (image QA, embeddings, fallback generation)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-key

# ---------------------------------------------------------------------------
# Resend (transactional email)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...your-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ---------------------------------------------------------------------------
# Jina AI (web search, reranking)
# ---------------------------------------------------------------------------
JINA_API_KEY=jina_...your-key

# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...your-token
# PODCLAW_ADMIN_TELEGRAM_CHAT_ID=123456789   # Admin chat for alerts

# ---------------------------------------------------------------------------
# WhatsApp Business (optional)
# ---------------------------------------------------------------------------
# WHATSAPP_ACCESS_TOKEN=your-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ---------------------------------------------------------------------------
# PodClaw Bridge Authentication
# ---------------------------------------------------------------------------
PODCLAW_BRIDGE_AUTH_TOKEN=your-secret-bridge-token
# PODCLAW_BRIDGE_AUTH_ENABLED=true

# ---------------------------------------------------------------------------
# PodClaw Tuning (optional — defaults are sensible)
# ---------------------------------------------------------------------------
# PODCLAW_DAILY_BUDGET=5.0               # EUR daily budget per agent
# PODCLAW_RESEARCH_MODEL=claude-haiku-4-5-20251001
# PODCLAW_COMPLEX_MODEL=claude-sonnet-4-5-20250929
# PODCLAW_MAX_ACTIONS_PER_CYCLE=50
# PODCLAW_MAX_TURNS_PER_AGENT=200
# PODCLAW_JSON_LOGS=true                 # JSON structured logs (recommended in Docker)
# PODCLAW_HEARTBEAT_ENABLED=true
# PODCLAW_HEARTBEAT_INTERVAL=30          # minutes
# PODCLAW_SOUL_EVOLUTION_ENABLED=true

# ---------------------------------------------------------------------------
# rembg Sidecar (auto-configured in Docker Compose)
# ---------------------------------------------------------------------------
# REMBG_URL=http://rembg:8080            # Set automatically by docker-compose

# ---------------------------------------------------------------------------
# Redis (auto-configured in Docker Compose)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://redis:6379            # Set automatically by docker-compose

# ---------------------------------------------------------------------------
# Store Identity (CAN-SPAM compliance)
# ---------------------------------------------------------------------------
# STORE_PHYSICAL_ADDRESS=Your Store, Street 123, City, Country
# STORE_SENDER_NAME=Your Store Name
